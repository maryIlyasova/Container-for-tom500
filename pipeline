def save_results_csv(res_A: List[Dict], res_B: List[Dict], res_C: List[Dict], path: str | Path = "results_summary.csv") -> pd.DataFrame:
    rows = []
    for arm_lbl, arm_res in zip(ARM_LABELS, [res_A, res_B, res_C]):
        for r in arm_res:
            rows.append({
                "arm":      arm_lbl,
                "model":    r["model"],
                "mean_auc": round(r["mean_auc"], 4),
                "std_auc":  round(r["std_auc"],  4),
                "time_s":   round(r["training_time_s"], 2),
                **{f"fold_{i+1}": round(v, 4) for i, v in enumerate(r["auc_scores"])},
            })
    df = pd.DataFrame(rows)
    df.to_csv(path, index=False)
    return df


