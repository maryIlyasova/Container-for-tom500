# STAGE 4 — PRINT-READY SHAP ANALYSIS (300 DPI PNG)
# ═════════════════════════════════════════════════════════════════════════════

def run_shap_analysis(
    X:              np.ndarray,
    y:              np.ndarray,
    feature_names:  List[str],
    output_path:    str | Path = "shap_summary.png",
    importance_csv: str | Path = "shap_importance.csv",
    top_n_console:  int = 10,
) -> Optional[pd.DataFrame]:
    if not HAS_SHAP:
        log.warning("Skipping SHAP analysis — shap package not available.")
        return None

    rf = Pipeline([("imp", SimpleImputer(strategy="median")), ("clf", RandomForestClassifier(n_estimators=300, class_weight="balanced", random_state=42, n_jobs=-1))])
    rf.fit(X, y)

    imp_X  = rf.named_steps["imp"].transform(X)
    rf_clf = rf.named_steps["clf"]

    explainer   = shap.TreeExplainer(rf_clf)
    shap_values = explainer.shap_values(imp_X)
    sv1         = shap_values[1] if isinstance(shap_values, list) else (shap_values[:, :, 1] if shap_values.ndim == 3 else shap_values)

    plt.rcdefaults()
    plt.rcParams.update({
        "font.size":        12,
        "text.color":       PALETTE["text"],
        "axes.labelcolor":  PALETTE["text"],
        "xtick.color":      PALETTE["text"],
        "ytick.color":      PALETTE["text"],
        "axes.facecolor":   PALETTE["panel"],
        "figure.facecolor": PALETTE["bg"],
    })

    n_display = min(20, len(feature_names))
    plt.figure(figsize=(11, 8), facecolor=PALETTE["bg"])

    shap.summary_plot(
        sv1, imp_X,
        feature_names = feature_names,
        show          = False,
        plot_size     = None,
        color_bar     = True,
        max_display   = n_display,
    )

    ax = plt.gca()
    ax.set_facecolor(PALETTE["panel"])
    ax.tick_params(colors=PALETTE["text"], labelsize=11)
    ax.set_xlabel("SHAP value (impact on model output — predicting CAS ≥ 2)", color=PALETTE["text"], fontsize=12)
    ax.grid(axis="x", color=PALETTE["gridl"], lw=0.9, alpha=0.9)

    plt.title("SHAP Summary · Feature Importance (CAS ≥ 2)", color=PALETTE["text"], fontsize=14, fontweight="bold", pad=14)

    out_p = Path(output_path)
    plt.savefig(str(out_p), dpi=300, bbox_inches="tight", facecolor=PALETTE["bg"])
    plt.close()
    plt.rcdefaults()

    importance = np.abs(sv1).mean(axis=0)
    df_imp = pd.DataFrame({"feature": feature_names, "mean_abs_shap": importance}).sort_values("mean_abs_shap", ascending=False).reset_index(drop=True)
    df_imp.to_csv(str(importance_csv), index=False)

    return df_imp


